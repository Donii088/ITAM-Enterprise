# Base URL of the ITAM WebApi. Include the /api suffix.
# Dev backend default (see Itam.WebApi/Properties/launchSettings.json): http://localhost:5266/api
VITE_API_URL=http://localhost:5266/api

VITE_APP_NAME=ITAM Enterprise
VITE_DEFAULT_PAGE_SIZE=10

# Max attachment size in bytes accepted client-side before upload.
# Mirrors Itam.Application FileStorageSettings.MaxFileSizeBytes (5 MB default).
VITE_MAX_UPLOAD_SIZE_BYTES=5242880
