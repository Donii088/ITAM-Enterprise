{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ItamDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "JwtSettings": {
    "Secret": "SuperSecretKeyForJwtTokenGenerationThatIsAtLeast32BytesLong!",
    "Issuer": "Itam.WebApi",
    "Audience": "Itam.Clients",
    "AccessTokenExpirationInMinutes": 15,
    "RefreshTokenExpirationInDays": 7
  },
  "SeedSettings": {
    "AdminEmail": "admin@company.com",
    "AdminPassword": "Admin@12345"
  },
  "FileStorageSettings": {
    "RootFolder": "uploads",
    "MaxFileSizeBytes": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".pdf" ]
  },
  "CorsSettings": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
